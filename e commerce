<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Simple E-Commerce Website</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f4f4f4;
}

header{
    background:#0077cc;
    color:white;
    padding:15px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

header nav a{
    color:white;
    text-decoration:none;
    margin:0 10px;
    font-weight:bold;
}

.hero{
    background:#333;
    color:white;
    text-align:center;
    padding:60px 20px;
}

.hero h1{
    font-size:40px;
}

.products{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
    padding:30px;
}

.card{
    background:white;
    border-radius:10px;
    padding:15px;
    text-align:center;
    box-shadow:0 0 10px rgba(0,0,0,0.1);
}

.card img{
    width:100%;
    height:180px;
    object-fit:cover;
    border-radius:8px;
}

.price{
    color:green;
    font-size:22px;
    margin:10px 0;
}

button{
    background:#0077cc;
    color:white;
    border:none;
    padding:10px 20px;
    border-radius:5px;
    cursor:pointer;
}

button:hover{
    background:#005fa3;
}

footer{
    background:#222;
    color:white;
    text-align:center;
    padding:15px;
    margin-top:20px;
}
</style>
</head>

<body>

<header>
<h2>MyShop</h2>

<nav>
<a href="#">Home</a>
<a href="#">Products</a>
<a href="#">Cart</a>
<a href="#">Contact</a>
</nav>
</header>

<section class="hero">
<h1>Welcome to MyShop</h1>
<p>Best Deals on Electronics, Fashion & Accessories</p>
</section>

<section class="products">

<div class="card">
<img src="https://via.placeholder.com/250x180" alt="Laptop">
<h3>Laptop</h3>
<p class="price">$799</p>
<button>Add to Cart</button>
</div>

<div class="card">
<img src="https://via.placeholder.com/250x180" alt="Phone">
<h3>Smart Phone</h3>
<p class="price">$499</p>
<button>Add to Cart</button>
</div>

<div class="card">
<img src="https://via.placeholder.com/250x180" alt="Headphones">
<h3>Headphones</h3>
<p class="price">$99</p>
<button>Add to Cart</button>
</div>

<div class="card">
<img src="https://via.placeholder.com/250x180" alt="Watch">
<h3>Smart Watch</h3>
<p class="price">$149</p>
<button>Add to Cart</button>
</div>

</section>

<footer>
<p>&copy; 2026 MyShop. All Rights Reserved.</p>
</footer>

</body>
</html>
